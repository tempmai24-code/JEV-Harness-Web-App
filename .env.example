# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TypeSafe AI JEV System-One Engine API Configuration
# Used by backend proxy (/api/jev/evaluate) for sub-second probabilistic risk assessment
TYPESAFE_API_KEY="YOUR_TYPESAFE_API_KEY"
JEV_API_ENDPOINT="https://api.typesafe.ai/v1/jev"

# Arkham Intelligence API Configuration
# Used by backend proxy (/api/arkham/intel) for entity attribution and smart-money labeling
ARKHAM_API_KEY="YOUR_ARKHAM_API_KEY"
ARKHAM_API_ENDPOINT="https://api.arkhamintelligence.com/v1"

# Nansen Intelligence API Configuration
# Used by backend proxy (/api/nansen/flow) for token flow, mempool bot clustering, and liquidity depth
NANSEN_API_KEY="YOUR_NANSEN_API_KEY"
NANSEN_API_ENDPOINT="https://api.nansen.ai/v1"

# Arbitrum One Execution RPC & Alchemy WebSocket Feed
# Used for mempool logs and Aave V3 FlashLoan execution on Arbitrum One (Chain ID 42161)
ARBITRUM_RPC_URL="https://arb1.arbitrum.io/rpc"
ALCHEMY_WS_URL="wss://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"

# Bot Execution Signer Wallet (Arbitrum One)
# Server-side signer for private transaction dispatch (optional if using client Web3 browser wallet)
EXECUTOR_WALLET_ADDRESS="0x0000000000000000000000000000000000000000"
EXECUTOR_PRIVATE_KEY=""

